# Salin ke .env.local untuk development lokal (JANGAN di-commit)
# Di Vercel isi lewat: Project > Settings > Environment Variables

GEMINI_API_KEY=
OPENAI_API_KEY=

# Opsional: nama model (bisa diganti tanpa ubah kode)
GEMINI_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
OPENAI_IMAGE_QUALITY=medium

# Opsional tapi sangat disarankan: kode akses sederhana agar
# orang asing tidak bisa menghabiskan kredit API Anda.
ACCESS_CODE=
